# ==========================================
# InkSight Environment Variables Configuration
# ==========================================

# ------------------------------------------
# Gemini AI Configuration
# ------------------------------------------
# GEMINI_API_KEY: Required for Gemini 3.8 Flash AI tag extraction.
# In AI Studio, this is injected automatically from user secrets.
# For local development, get an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------
# Application Server
# ------------------------------------------
PORT=3000
APP_URL="http://localhost:3000"

# ------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------
# When DB_HOST or DATABASE_URL is defined, InkSight connects to your external
# PostgreSQL database. If omitted, InkSight defaults to the embedded PostgreSQL
# engine with local file persistence in ./data.

# DB_HOST: Hostname or IP of the PostgreSQL server (e.g. localhost, 127.0.0.1, or Cloud SQL proxy)
DB_HOST="localhost"

# DB_PORT: Port on which the PostgreSQL server is listening (default: 5432)
DB_PORT="5432"

# DB_NAME: Database name
DB_NAME="inksight_db"

# DB_USER: Database username
DB_USER="postgres"

# DB_PASSWORD / Passkey: Database password / access passkey
DB_PASSWORD="your_database_password_here"

# DB_SSL: Set to 'true' if connecting with SSL (e.g., hosted Postgres, Supabase, Neon, Cloud SQL)
DB_SSL="false"

# DATABASE_URL: Optional direct connection URI (supersedes individual DB_* vars if set)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/inksight_db"
